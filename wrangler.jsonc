// 에셋온 홈페이지 — Cloudflare Workers 설정
// 배포: GitHub 저장소를 Cloudflare Workers Builds 에 연결하면 main 브랜치에 올릴 때마다 자동 배포됩니다.
//       (빌드 명령은 아래 build.command 가 wrangler deploy 때 함께 실행합니다)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asseton",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // public/ 의 HTML·CSS·JS·폰트를 그대로 내보냅니다. /api/* 만 Worker 코드가 먼저 받습니다.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // 배포 전에 페이지를 새로 만듭니다 (src/ 를 고치면 public/ 이 다시 생성됨)
  "build": { "command": "node src/build.mjs" },

  // 환경 변수와 비밀값(INQUIRY_TO, INQUIRY_FROM, RESEND_API_KEY, TURNSTILE_SECRET)은
  // Cloudflare 대시보드에서 넣습니다. 아래 설정이 있어야 배포할 때 대시보드 값이 지워지지 않습니다.
  "keep_vars": true

  // 신청 내용을 1년간 보관하려면 KV 네임스페이스를 만들고 아래 주석을 풉니다.
  // ,"kv_namespaces": [{ "binding": "INQUIRIES", "id": "여기에 KV ID" }]
}
